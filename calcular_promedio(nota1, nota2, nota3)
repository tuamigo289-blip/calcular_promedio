def calcular_promedio(nota1, nota2, nota3):
    """
    Función que recibe tres notas como parámetros
    y retorna el promedio calculado.
    """
    promedio = (nota1 + nota2 + nota3) / 3
    return promedio


# Programa principal
print("=== Calculadora de Promedio de Notas ===")
n1 = float(input("Ingrese la primera nota: "))
n2 = float(input("Ingrese la segunda nota: "))
n3 = float(input("Ingrese la tercera nota: "))

# Llamada a la función
resultado = calcular_promedio(n1, n2, n3)

# Mostrar el resultado
print(f"\nEl promedio de las notas es: {resultado:.2f}")

if resultado >= 7:
    print("¡Aprobado!")
else:
    print("Reprobado, necesitas mejorar.")
